ADMIN_USER=admin
# Set a unique password of at least 12 characters before first startup.
ADMIN_PASSWORD=
PUBLIC_URL=http://localhost:8080
BIND_ADDRESS=127.0.0.1
PORT=8080
# Defaults to the Compose project name. Keep stable to preserve game volumes.
# GAMEDOCK_NAMESPACE=gamedock
# Optional standalone HTTPS: use examples/https/compose.yaml and a trusted cert.
# TLS_DIRECTORY=/absolute/path/to/certificates

# Optional Linux virtual gamepad backend; requires /dev/uinput (see examples/controllers).
GAMEDOCK_UINPUT=0
